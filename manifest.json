{
  "manifest_version": 3,
  "name": "SolveSync",
  "version": "0.4.0",
  "description": "Sync accepted solutions from LeetCode, Codeforces, AtCoder, CSES, CodeChef and Repovive to a GitHub repo, only for the usernames you choose.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://api.github.com/*", "https://github.com/login/*", "https://kenkoooo.com/atcoder/atcoder-api/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "SolveSync",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["lib/inject-leetcode.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["lib/shared.js", "lib/content.js", "content/leetcode.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://codeforces.com/*"],
      "js": ["lib/shared.js", "lib/content.js", "content/codeforces.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://cses.fi/*"],
      "js": ["lib/shared.js", "lib/content.js", "content/cses.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.codechef.com/*"],
      "js": ["lib/inject-editor.js", "lib/inject-codechef.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.codechef.com/*"],
      "js": ["lib/shared.js", "lib/content.js", "content/codechef.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://repovive.com/*", "https://www.repovive.com/*"],
      "js": ["lib/inject-editor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://repovive.com/*", "https://www.repovive.com/*"],
      "js": ["lib/shared.js", "lib/content.js", "content/repovive.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://atcoder.jp/*"],
      "js": ["lib/shared.js", "lib/content.js", "content/atcoder.js"],
      "run_at": "document_idle"
    }
  ]
}
